# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-no-key-required

# ---------------------------------------------------------------------------
# Model provider (Agent responses)
# - Default cloud OpenAI: MODEL_PROVIDER=openai
# - Local llama.cpp (OpenAI-compatible): MODEL_PROVIDER=llama.cpp
# ---------------------------------------------------------------------------
MODEL_PROVIDER=llama.cpp
MODEL_ID=/home/oia/.cache/huggingface/hub/models--ggml-org--gpt-oss-20b-GGUF/snapshots/ef9b12f2ff56c69cf32153a02784e7a3c88bf524/gpt-oss-20b-MXFP4.gguf
OPENAI_BASE_URL=http://llama:8080/v1

# ---------------------------------------------------------------------------
# Embedder provider (Knowledge vectors)
# Point to an embeddings-capable OpenAI-compatible endpoint.
# If your local runtime does not expose /v1/embeddings, keep this as OpenAI
# or swap to another supported local embedder in code.
# ---------------------------------------------------------------------------
EMBEDDER_MODEL_ID=text-embedding-3-small
EMBEDDER_BASE_URL=http://llama:8080/v1
EMBEDDER_API_KEY=sk-no-key-required

# ---------------------------------------------------------------------------
# JWT verification for AgentOS. Generate your JWT_VERIFICATION_KEY at os.agno.com.
# In production (RUNTIME_ENV != dev), the app refuses to serve traffic without
# JWT_VERIFICATION_KEY or JWT_JWKS_FILE. Local dev (RUNTIME_ENV=dev) is ok without it.
# Set `authorization=False` in app/main.py to opt out (not recommended).
# ---------------------------------------------------------------------------
# Quote the value so parsers read the multi-line PEM as one variable:
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
# JWT_JWKS_FILE=/app/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# Optional: pin the OAuth token signing key (≥32 chars). Unset, a strong key is
# generated and persisted in the database. Rotating it invalidates outstanding tokens.
# AGENTOS_MCP_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Chief's and the Studio registry's web search tools use the Parallel SDK
# when authenticated, and fall back to Parallel's keyless MCP server otherwise.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Schedules
# ---------------------------------------------------------------------------
# ENABLE_DEPLOY_CHECK=True
# EVALS_TAG=smoke
# EVALS_CASE_TIMEOUT_SECONDS=90
# EVALS_SUITE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Slack — set both to enable the Slack interface.
#   SLACK_BOT_TOKEN       Bot User OAuth Token (xoxb-***)
#   SLACK_SIGNING_SECRET  Signing Secret (Basic Information → App Credentials)
# ---------------------------------------------------------------------------
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=ai
# DB_PASS=ai
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# ---------------------------------------------------------------------------
# AD Assessment integration (workflow: ad-assessment-run)
# ---------------------------------------------------------------------------
# Root path where the ad-assessment repository is available to the AgentOS runtime.
# For Docker, mount the repo into this path inside the container.
AD_ASSESSMENT_ROOT=/workspace/ad-assessment

# Default domain if workflow input does not provide one.
AD_ASSESSMENT_DEFAULT_DOMAIN=test.com

# Output folder for generated JSON/CSV/HTML artifacts.
AD_ASSESSMENT_OUTPUT_PATH=/tmp/ad-assessment-output

# Optional behavior flags
AD_ASSESSMENT_INCLUDE_PKI=false
AD_ASSESSMENT_GENERATE_MERMAID=false

# Max execution time in seconds for one workflow run.
AD_ASSESSMENT_TIMEOUT_SECONDS=1800

# Optional external runner endpoint (Windows/RSAT worker)
# AD_ASSESSMENT_RUNNER_URL=http://runner-host:8090/run
AD_ASSESSMENT_RUNNER_TIMEOUT_SECONDS=20

# Llama runtime checks (oia-runtime)
LLAMA_BASE_URL=http://llama:8080
LLAMA_BASE_URL_HOST=http://127.0.0.1:18080
LLAMA_CONTAINER_IMAGE=oia-llama-full-cuda13-tools:local
LLAMA_HEALTH_TIMEOUT_SECONDS=8
